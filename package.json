{
  "name": "flightdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal cockpit for the Claude Agent SDK that enforces the verification doctrine in process.",
  "bin": {
    "flightdeck": "./dist/cli.js",
    "forge": "./dist/forge/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs && npm run console:build",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "typecheck:console": "tsc -p tsconfig.console.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ux": "vitest run tests/console/ux-identifier-lint.test.tsx tests/console/ux-question-contract.test.tsx tests/console/ux-one-action-per-state.test.tsx",
    "check:agnostic": "tsx tests/checks/agnostic.ts",
    "check:faultinject": "tsx tests/checks/fault-inject.ts",
    "check:roadmap": "tsx scripts/check-roadmap.ts",
    "desktop:test": "npm --prefix desktop test",
    "verify": "npm run typecheck && npm run typecheck:console && npm run test && npm run check:ux && npm run check:agnostic && npm run check:roadmap && npm run check:faultinject && npm run desktop:test",
    "forge": "tsx src/forge/cli.ts",
    "console:dev": "vite --config vite.console.config.ts",
    "console:build": "vite build --config vite.console.config.ts",
    "console:preview": "vite preview --config vite.console.config.ts",
    "console:stub": "tsx src/console/stub-server.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.229",
    "ink": "^7.1.1",
    "react": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
