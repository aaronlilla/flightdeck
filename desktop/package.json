{
  "name": "forge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for the Forge console. Finds or starts the console on 127.0.0.1:4120 and shows it in a window.",
  "type": "commonjs",
  "main": "build/main.cjs",
  "scripts": {
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --loader:.png=dataurl --outfile=build/main.cjs",
    "build:preload": "esbuild electron/status-preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=build/status-preload.cjs",
    "build:app": "npm run build:main && npm run build:preload",
    "dist": "npm run build:app && electron-builder --win --x64 --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "rcedit": "^4.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true
  }
}
